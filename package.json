{
  "name": "tonygitlens",
  "displayName": "TonyGitLens",
  "description": "Fast, lightweight GitLens-inspired extension for viewing Git worktrees and commits",
  "version": "0.1.0",
  "publisher": "tonyho",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:tonygitlens.worktreesView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tonygitlens-container",
          "title": "TonyGitLens",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "tonygitlens-container": [
        {
          "id": "tonygitlens.worktreesView",
          "name": "Worktrees & Commits"
        },
        {
          "id": "tonygitlens.compareView",
          "name": "Compare Branches"
        }
      ],
      "scm": [
        {
          "id": "tonygitlens.worktreesViewScm",
          "name": "Worktrees (TonyGitLens)"
        }
      ]
    },
    "commands": [
      {
        "command": "tonygitlens.refresh",
        "title": "Refresh Worktrees",
        "icon": "$(refresh)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.openWorktree",
        "title": "Open Worktree in New Window",
        "icon": "$(window)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.revealInFileExplorer",
        "title": "Reveal in File Explorer",
        "icon": "$(folder-opened)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.copyCommitSha",
        "title": "Copy Commit SHA",
        "icon": "$(copy)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.diffCommitFile",
        "title": "View Changes",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.loadMoreCommits",
        "title": "Load More Commits",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.compareWorktreeBranch",
        "title": "Compare with...",
        "icon": "$(git-compare)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.compareBranches",
        "title": "Compare Branches...",
        "icon": "$(git-compare)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.swapComparison",
        "title": "Swap Base and Target",
        "icon": "$(arrow-swap)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.clearComparison",
        "title": "Clear Comparison",
        "icon": "$(clear-all)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.clearBranchComparison",
        "title": "Clear Comparison",
        "icon": "$(close)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.swapBranchComparison",
        "title": "Swap Base and Target",
        "icon": "$(arrow-swap)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.clearAllComparisons",
        "title": "Clear All Comparisons",
        "icon": "$(clear-all)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.refreshComparison",
        "title": "Refresh Comparison",
        "icon": "$(refresh)",
        "category": "TonyGitLens"
      },
      {
        "command": "tonygitlens.diffCompareFile",
        "title": "View File Diff",
        "category": "TonyGitLens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tonygitlens.refresh",
          "when": "view == tonygitlens.worktreesView || view == tonygitlens.worktreesViewScm",
          "group": "navigation@1"
        },
        {
          "command": "tonygitlens.clearComparison",
          "when": "view == tonygitlens.worktreesView || view == tonygitlens.worktreesViewScm",
          "group": "navigation@2"
        },
        {
          "command": "tonygitlens.swapComparison",
          "when": "view == tonygitlens.compareView",
          "group": "navigation@1"
        },
        {
          "command": "tonygitlens.refreshComparison",
          "when": "view == tonygitlens.compareView",
          "group": "navigation@2"
        },
        {
          "command": "tonygitlens.clearComparison",
          "when": "view == tonygitlens.compareView",
          "group": "navigation@3"
        },
        {
          "command": "tonygitlens.compareBranches",
          "when": "view == tonygitlens.compareView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "tonygitlens.compareWorktreeBranch",
          "when": "viewItem == worktree",
          "group": "inline@1"
        },
        {
          "command": "tonygitlens.openWorktree",
          "when": "viewItem == worktree",
          "group": "inline@2"
        },
        {
          "command": "tonygitlens.compareWorktreeBranch",
          "when": "viewItem == worktree",
          "group": "worktree_actions@0"
        },
        {
          "command": "tonygitlens.clearBranchComparison",
          "when": "viewItem == worktree",
          "group": "worktree_actions@1"
        },
        {
          "command": "tonygitlens.revealInFileExplorer",
          "when": "viewItem == worktree",
          "group": "worktree_actions@2"
        },
        {
          "command": "tonygitlens.copyCommitSha",
          "when": "viewItem == commit",
          "group": "commit_actions@1"
        },
        {
          "command": "tonygitlens.compareWorktreeBranch",
          "when": "viewItem == worktreeCompareActive",
          "group": "inline@1"
        },
        {
          "command": "tonygitlens.swapBranchComparison",
          "when": "viewItem == worktreeCompareActive",
          "group": "inline@2"
        },
        {
          "command": "tonygitlens.clearBranchComparison",
          "when": "viewItem == worktreeCompareActive",
          "group": "inline@3"
        },
        {
          "command": "tonygitlens.clearBranchComparison",
          "when": "viewItem == worktreeCompareActive",
          "group": "compare_branch_actions@1"
        },
        {
          "command": "tonygitlens.swapBranchComparison",
          "when": "viewItem == worktreeCompareActive",
          "group": "compare_branch_actions@2"
        },
        {
          "command": "tonygitlens.compareWorktreeBranch",
          "when": "viewItem == worktreeCompareActive",
          "group": "compare_branch_actions@3"
        },
        {
          "command": "tonygitlens.clearBranchComparison",
          "when": "viewItem =~ /^compareSection/",
          "group": "compare_section_actions@1"
        },
        {
          "command": "tonygitlens.swapComparison",
          "when": "viewItem == compareRoot",
          "group": "inline@1"
        },
        {
          "command": "tonygitlens.clearComparison",
          "when": "viewItem == compareRoot",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "package:vsix": "npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('esbuild').buildSync({entryPoints:['test/gitCliService.test.ts'],bundle:true,platform:'node',outfile:'dist/test.js',external:['vscode']});\" && node dist/test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
